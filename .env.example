# Tizita Studio — copy to .env and fill in. .env is gitignored; never commit real values.
# Names here are exactly the names the code reads (no aliases).
# Needed for the default `free` profile: one GEMINI_API_KEY_n, the Cloudflare pair, the Kaggle pair.

# --- Required for the default free-hosted chain ---
GEMINI_API_KEY_1=               # Google AI Studio (text, TTS, ASR). Free tier may train on inputs.
GEMINI_API_KEY_2=               # optional: a key from a DIFFERENT Google project (own free quota);
GEMINI_API_KEY_3=               # tried in order, next key on 429/quota. Add more by editing providers.yaml.
CLOUDFLARE_ACCOUNT_ID=          # Workers AI (FLUX.2 klein / FLUX.1 schnell, text, Whisper)
CLOUDFLARE_API_TOKEN=           # token with the "Workers AI" permission
KAGGLE_USERNAME=                # Kaggle (Wan 2.2 + ACE-Step batches); phone-verified account
KAGGLE_KEY=

# --- Optional free-hosted fallbacks ---
HF_TOKEN=                       # Hugging Face: Spaces (gradio_client), Inference Providers, gated weights
GROQ_API_KEY=                   # Groq free tier (text / Whisper fallback)
OPENROUTER_API_KEY=             # OpenRouter `:free` models (text fallback)

# --- Optional paid providers (never called unless the profile allows it, ALLOW_PAID and a budget) ---
FAL_KEY=                        # fal.ai (FLUX.2 / Wan 2.2 / ACE-Step)
REPLICATE_API_TOKEN=            # Replicate (same capabilities)
GEMINI_ORG_API_KEY=             # organisation "frontier lane" key, if provided (Omni Flash, Nano Banana, Lyria)

# --- Pipeline settings ---
TIZITA_PROFILE=free             # free | free+local | local-first | paid | custom
TIZITA_LOG_LEVEL=info
ALLOW_PAID=false                # must be true (and PAID_BUDGET_USD > 0) for paid providers
PAID_BUDGET_USD=0               # hard cap for paid spend, e.g. 5
MODELS_DIR=~/models/tizita      # local weights, outside the repo

# --- Showcase deployment (M7/M8 only; the graded pipeline never needs these) ---
TIZITA_API_BASE_URL=            # e.g. https://api.example.com (worker side)
TIZITA_PUBLIC_URL=              # public site URL
TIZITA_ADMIN_INVITE_TOKEN=      # admin invite token for studio pages
TIZITA_EDGE_AUTH_SECRET=        # shared X-Edge-Auth header between the CF Worker and the API
TIZITA_WORKER_TOKEN=            # GPU worker auth
TIZITA_DB_URL=
STORAGE_BACKEND=local           # r2 | local
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SIGNED_URL_TTL_S=
TUNNEL_TOKEN=                   # cloudflared tunnel on the VPS
